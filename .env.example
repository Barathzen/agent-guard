# Local PostgreSQL connection (no Docker).
# Replace the user, password, host, port, and database with your own local values.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentguard

APP_ENV=development
GATEWAY_API_KEY=dev-gateway-key
GATEWAY_TIMEOUT_SECONDS=30.0
RESERVATION_STALENESS_MINUTES=60
RESERVATION_RECOVERY_INTERVAL_MINUTES=5
MONITORING_SSE_INTERVAL_SECONDS=5.0
RUNAWAY_WINDOW_MINUTES=60
RUNAWAY_MONTHLY_BUDGET_PCT=20
